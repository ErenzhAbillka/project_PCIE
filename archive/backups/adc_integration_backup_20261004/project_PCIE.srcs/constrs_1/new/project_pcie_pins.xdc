# MLK-H4 PCIe x8: base schematic page 11, core banks 226/227.
# XDMA X0Y1 internally maps lane0 to GT227 CH3 (X1Y15).
# Match connector lane numbering directly; do not reverse again in RTL/XDC.
set_property PACKAGE_PIN F2 [get_ports {pcie_7x_mgt_rtl_0_rxp[0]}]
