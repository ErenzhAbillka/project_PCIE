create_clock -name pcie_refclk -period 10.000 [get_ports {diff_clock_rtl_0_clk_p[0]}]
set_property -dict {PACKAGE_PIN K22 IOSTANDARD LVCMOS33 PULLUP true} [get_ports reset_rtl_0]
set_false_path -from [get_ports reset_rtl_0]
# Core configuration bank: CFGBVS tied to VCCO=3.3 V.
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
